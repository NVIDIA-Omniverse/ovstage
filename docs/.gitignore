# The repo-root .gitignore ignores every directory starting with "_" (_*/).
# Keep the Sphinx build output ignored (regenerated by `make html`)...
_build/
_doxygen/

# ...but re-include the tracked Sphinx source directories that _*/ would hide.
!_ext/
!_static/

# Never track the compiled Python cache inside the re-included _ext/ dir.
_ext/__pycache__/
*.py[cod]
